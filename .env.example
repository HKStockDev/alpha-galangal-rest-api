# Required for Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional – use service role (secret key) for hedge funds CSV upload and for persisting
# events/news classifier output to `market_content*` (admin preview when "Save to database" is on).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth → Hooks → Send email → HTTP endpoint POST {API}/auth/hooks/send-email
# Generate the secret in the hook UI (format v1,whsec_...). Also set Site URL + Redirect URLs in
# Authentication → URL Configuration (see FRONTEND_URL below).
# SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Required for Hedge Fund Quality Score (POST /hedge-funds/calculate-quality-scores)
# Supabase Settings → Database → Connection string → copy the password
# POSTGRES_PASSWORD=your-database-password
# SUPABASE_PROJECT_ID=your-project-ref
#
# Optional: full Postgres URI (Session pooler or Direct). When set, migrate scripts use this first.
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# When DATABASE_URL is unset, use Session pooler over IPv4 (db.<ref> is often IPv6-only):
# SUPABASE_POOLER_REGION=us-west-2

# Gemini API (optional)
# GEMINI_API_KEY=your-gemini-api-key
# Optional: market content classifier preview — retries on 429 / RESOURCE_EXHAUSTED (default 4 attempts, 1500 ms base backoff).
# GEMINI_PREVIEW_MAX_ATTEMPTS=4
# GEMINI_PREVIEW_RETRY_BASE_MS=1500

# Assistant runtime
# ASSISTANT_ENABLED=true
# ASSISTANT_EMBEDDING_MODEL=gemini-embedding-001
# ASSISTANT_KNOWLEDGE_SEARCH_TOP_K=8
# ASSISTANT_KNOWLEDGE_INDEX_ENABLED=true
# ASSISTANT_KNOWLEDGE_EMBED_BATCH=16
# When vector hits are weak or placeholder-only, query live DB (releases, formulas, client notes).
# ASSISTANT_KNOWLEDGE_SEARCH_FALLBACK_ENABLED=true
# ASSISTANT_KNOWLEDGE_SEARCH_MIN_SIMILARITY=0.55

# Assistant Phase 3: Typesense (optional fuzzy keyword retrieval)
# Keep disabled unless Typesense is running and reachable.
# ASSISTANT_TYPESENSE_ENABLED=false
# TYPESENSE_HOST=http://localhost:8108
# TYPESENSE_API_KEY=your-typesense-api-key
# ASSISTANT_TYPESENSE_COLLECTION=organization_knowledge_chunks
# ASSISTANT_TYPESENSE_TIMEOUT_MS=8000
# ASSISTANT_TYPESENSE_SYNC_LIMIT=5000

# FMP – stock data (company profile, insider trades, etc.)
# FMP_API_KEY=your-fmp-api-key
# FMP_API_BASE_URL=https://financialmodelingprep.com

# Massive – options data only (future)
# MASSIVE_API_KEY=your-massive-api-key
# MASSIVE_API_BASE_URL=https://api.polygon.io

# Apollo.io API (organization enrichment – https://apollo.io)
# APOLLO_API_KEY=your-apollo-api-key
# APOLLO_API_BASE_URL=https://api.apollo.io/api/v1

# Apify (CON-45 jobs ingestion via Indeed actor; headcount page via LinkedIn actors)
# APIFY_API_TOKEN=your-apify-token
# APIFY_API_BASE_URL=https://api.apify.com
# APIFY_INDEED_ACTOR_ID=kaix/indeed-scraper
# https://apify.com/logical_scrapers/linkedin-company-scraper
# APIFY_LINKEDIN_LOGICAL_COMPANY_SCRAPER_ID=logical_scrapers/linkedin-company-scraper
# https://apify.com/riceman/linkedin-company-data-insights-scraper
# APIFY_LINKEDIN_RICEMAN_INSIGHTS_ID=riceman/linkedin-company-data-insights-scraper
# https://apify.com/s-r/free-linkedin-company-finder---linkedin-address-from-any-site
# APIFY_LINKEDIN_COMPANY_FINDER_ID=s-r/free-linkedin-company-finder---linkedin-address-from-any-site

# Congress.gov API (members, committees – get key at https://api.congress.gov/sign-up)
# CONGRESS_GOV_API_KEY=your-congress-gov-api-key
# CONGRESS_GOV_BASE_URL=https://api.congress.gov

# Dashboard → Developers → API keys (test: sk_test_...). Webhook signing secret after creating POST /billing/webhook.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional; default to FRONTEND_URL (or http://app.localhost:3000) + path below.
# STRIPE_CHECKOUT_SUCCESS_URL=http://app.localhost:3000/billing/success
# STRIPE_CHECKOUT_CANCEL_URL=http://app.localhost:3000/billing/cancel
# STRIPE_BILLING_PORTAL_RETURN_URL=http://app.localhost:3000/settings/billing
# free-trial length in days (Checkout subscription_data.trial_period_days)
# STRIPE_TRIAL_DAYS=14
# Optional: use a fixed Portal configuration id (bpc_...) instead of auto-sync from subscription_plans
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...

# Organization invitations (create, resend, accept), password reset, signup verification — Resend required.
# FRONTEND_URL is also passed as emailRedirectTo on signup and must be listed under Supabase
# Authentication → URL Configuration → Redirect URLs, e.g.:
#   https://app.withprecision.ai/auth/callback
#   https://app.withprecision.ai/auth/confirm
#   https://app.withprecision.ai/verify-email
# Local merged app: use app host where /invite, /reset-password/confirm, and /verify-email live
# FRONTEND_URL=http://app.localhost:3000
# RESEND_API_KEY=re_xxx
# INVITE_FROM_EMAIL=alex@withprecision.ai

# In-process Nest data sync (@nestjs/schedule). Standard 5-field cron; leave empty to disable a job.
# Times use the API server’s local timezone unless you set TZ on the process.
#
# FMP senate/house → political_trades (matched to current members; optional securities backfill in code).
# DATA_SYNC_CRON_FMP_POLITICAL_TRADES=0 */6 * * *
#
# FMP political feeds → securities (gap fill): symbols in senate/house “latest” not yet in `securities`
# get a /stable/profile upsert (~250ms/symbol). Schedule before or between political_trades runs if desired.
# Example: minute 55 of hours 0,6,12,18 — a few minutes before FMP political_trades at minute 0.
# DATA_SYNC_CRON_FMP_POLITICAL_FEED_MISSING_SECURITIES=55 */6 * * *
#
# DATA_SYNC_CRON_CONGRESS_MEMBERS=0 7 * * *
# DATA_SYNC_CRON_COMMITTEE_MEMBERSHIPS=30 8 * * *
# DATA_SYNC_CRON_TAXONOMY_STRUCTURAL_GROWTH_CAGR_SCORES=0 9 * * *
#
# All active equities (`securities.market=stocks`) → Gemini security_exposures (weekly recommended).
# Example: Sunday 02:00 server local time — 0 2 * * 0
# DATA_SYNC_CRON_EQUITY_EXPOSURES=0 2 * * 0
# Optional delay between tickers (ms) to reduce Gemini rate pressure; default 400.
# DATA_SYNC_EQUITY_EXPOSURES_DELAY_MS=400
#
# Sector/industry/sub-industry cycle scores (1m/3m/6m/12m/24m) via Gemini; weekly recommended.
# Example: Sunday 03:15 — 15 3 * * 0
# DATA_SYNC_CRON_TAXONOMY_CYCLE_SCORES=15 3 * * 0
# Optional delay between taxonomy entities (ms); default 1500.
# DATA_SYNC_TAXONOMY_CYCLE_SCORES_DELAY_MS=1500
#
# Formula score syncs (weekly UTC defaults also in trigger-task-ids.ts):
# DATA_SYNC_CRON_FORMULA_POLITICAL_SCORE=0 10 * * 1
# DATA_SYNC_CRON_FORMULA_INSIDER_PRECISION_SCORE=30 10 * * 1
# DATA_SYNC_CRON_FORMULA_NET_EXPOSURE_SCORE=0 11 * * 1
# DATA_SYNC_CRON_FORMULA_HEDGE_FUND_QUALITY_SCORE=30 11 * * 1
# DATA_SYNC_CRON_FORMULA_FUNDAMENTAL_CONSTRICTION_SCORE=0 12 * * 1
# DATA_SYNC_CRON_FORMULA_BUFFETT_COMMITTEE_SCORE=0 4 * * 0
# DATA_SYNC_CRON_FORMULA_BURRY_COMMITTEE_SCORE=30 4 * * 0
# DATA_SYNC_CRON_FORMULA_AMERICA_FIRST_SCORE=30 12 * * 1

# --- Trigger.dev (background data sync) ---
# Project: proj_cvznhcslwvsomhwyqjjy — https://cloud.trigger.dev
# When TRIGGER_SECRET_KEY is set, manual sync endpoints dispatch to Trigger.dev and
# in-process Nest cron is disabled unless USE_NEST_DATA_SYNC_CRON=true.
# Use the **Development** secret key (tr_dev_…) if runs are triggered in the dev environment;
# use the **Production** key (tr_prod_…) for deployed/production runs. Mismatched keys return
# zero runs from runs.list() and the screener will show "Never run" until tasks write to DB.
# TRIGGER_SECRET_KEY=tr_dev_xxx
# Optional: personal access token for cross-environment run history (Trigger dashboard → Account → Personal access tokens)
# TRIGGER_ACCESS_TOKEN=tr_pat_xxx
# SYNC_RUN_INLINE=true   # force synchronous inline sync (local dev without Trigger)
# USE_NEST_DATA_SYNC_CRON=true   # keep Nest cron even when Trigger is configured
#
# DB-backed sync schedules (CON-186). When true (default), a single dispatcher cron
# evaluates admin-configured schedules every 15 minutes instead of per-job Trigger/Nest crons.
# USE_DB_SYNC_SCHEDULES=true
# DATA_SYNC_DISPATCHER_CRON=*/15 * * * *
# Set USE_DB_SYNC_SCHEDULES=false to roll back to legacy per-job DATA_SYNC_CRON_* / Trigger schedules.

# CORS: comma-separated browser origins (exact scheme+host+port, no path). Add every prod/staging app URL the browser uses.
# Default in code: app.localhost:3000 + localhost:3000. Production e.g.:
# CORS_ORIGIN=https://app.withprecision.ai,http://app.localhost:3000,http://localhost:3000
# CORS_ORIGIN=http://app.localhost:3000,http://localhost:3000

# Marketing contact form (POST /marketing/contact, no auth). Include your marketing site origin in CORS_ORIGIN above.
# Optional; defaults to alex@withprecision.ai in application config.
# CONTACT_FORM_NOTIFY_EMAIL=alex@withprecision.ai

# When your admin app calls http://host:3001/api/... set this to "api" so Nest serves /api/auth, /api/formulas, etc.
# Leave unset if clients use the root (e.g. http://host:3001/auth/login) without /api.
# API_GLOBAL_PREFIX=api

# ===========================================
# Social OAuth (CON-178–181): facebook, instagram, linkedin, x, tiktok
# Admin UI: Configuration → Social accounts
# Docs: Docs/Migration/con-178-181_social_oauth_runbook.md
# Local dev: API loads `.env.development` then `.env` (override). Never commit real secrets.
# Register every CALLBACK_URL in each provider's developer console (dev and prod differ).
# ===========================================

# App origin for invite/billing links; OAuth callbacks use the URLs below (usually same host).
# FRONTEND_URL=http://app.localhost:3000

# Precision org UUID from Supabase `organizations.id` — required for social admin routes
# PRECISION_ORGANIZATION_ID=your-precision-org-uuid

# --- LinkedIn (https://www.linkedin.com/developers/apps) ---
# Dev with ngrok (Meta/LinkedIn): use https://YOUR.ngrok-free.dev/api/auth/linkedin/callback
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_CALLBACK_URL=https://YOUR.ngrok-free.dev/api/auth/linkedin/callback
# LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social w_organization_social r_organization_social

# --- Meta Facebook + Instagram (https://developers.facebook.com/apps) ---
# Meta requires HTTPS locally — use ngrok. See Docs/oauth-dev-redirect-uris.md
# META_CREDENTIALS_PROFILE=development
# META_APP_ID_DEVELOPMENT=your-dev-meta-app-id
# META_APP_SECRET_DEVELOPMENT=your-dev-meta-app-secret
# META_CALLBACK_URL_DEVELOPMENT=http://app.localhost:3000/api/auth/facebook/callback
# META_INSTAGRAM_CALLBACK_URL_DEVELOPMENT=http://app.localhost:3000/api/auth/instagram/callback
# META_APP_ID_PRODUCTION=your-prod-meta-app-id
# META_APP_SECRET_PRODUCTION=your-prod-meta-app-secret
# META_CALLBACK_URL_PRODUCTION=https://app.withprecision.ai/api/auth/facebook/callback
# META_INSTAGRAM_CALLBACK_URL_PRODUCTION=https://app.withprecision.ai/api/auth/instagram/callback
# META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
# META_GRAPH_API_VERSION=v21.0

# --- X / Twitter (https://developer.x.com/en/portal/dashboard) ---
# X_CLIENT_ID=your-x-client-id
# X_CLIENT_SECRET=your-x-client-secret
# X_CALLBACK_URL=http://app.localhost:3000/api/auth/x/callback
# X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access

# --- TikTok (https://developers.tiktok.com/) ---
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# TIKTOK_CALLBACK_URL=http://app.localhost:3000/api/auth/tiktok/callback
# TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish

# --- Woop Social (https://docs.woopsocial.com/api-reference/overview) ---
# When set, connected accounts are managed via Woop Social instead of direct OAuth.
# WOOP_SOCIAL_API_KEY=your-woop-api-key
# WOOP_SOCIAL_BASE_URL=https://api.woopsocial.com/v1
# WOOP_SOCIAL_PROJECT_ID=optional-fixed-project-id
# WOOP_SOCIAL_PROJECT_NAME=Precision
# WOOP_WEBHOOK_SIGNING_SECRET=base64-secret-from-woop-webhook-registration

# Optional — encrypt OAuth tokens at rest (defaults to hashing SUPABASE_SERVICE_ROLE_KEY)
# SOCIAL_TOKEN_ENCRYPTION_KEY=
# Optional — HMAC for OAuth state param (defaults to SUPABASE_JWT_SECRET or service role key)
# SOCIAL_OAUTH_STATE_SECRET=

# --- Production overrides (CON-177) — set on host when NODE_ENV=production or VERCEL=1 ---
# Docs: Docs/Migration/con-177_production_env_vars.md
# META_APP_ID_PRODUCTION=
# META_APP_SECRET_PRODUCTION=
# META_CALLBACK_URL_PRODUCTION=https://app.withprecision.ai/api/auth/facebook/callback
# META_INSTAGRAM_CALLBACK_URL_PRODUCTION=https://app.withprecision.ai/api/auth/instagram/callback
# LINKEDIN_CALLBACK_URL=https://app.withprecision.ai/api/auth/linkedin/callback
# X_CALLBACK_URL=https://app.withprecision.ai/api/auth/x/callback
# TIKTOK_CALLBACK_URL=https://app.withprecision.ai/api/auth/tiktok/callback
# CORS_ORIGIN=https://app.withprecision.ai,https://withprecision.ai

PORT=3001
